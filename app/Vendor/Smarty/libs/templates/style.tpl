//Variables

$font-family: 'Roboto', sans-serif;
$medida-de-referencia: 14px;

$primary-color: #{$primary_color};
$primary-font-color: #{$primary_font_color};
$primary-background-color: #{$primary_background_color};

$secondary-color: #{$secondary_color};
$secondary-font-color: #{$secondary_font_color};
$secondary-background-color: #{$secondary_background_color};

$tertiary-color: #{$tertiary_color};

$menu-color: #{$menu_color};
$color-active: #{$color_active};
$menu-background-color: #{$menu_background_color};

$color-borde-elementos: #606060;
$radio-del-borde: 1em;
$color-exito: #{$color_exito};
$color-fallo: #{$color_fallo};
$color-informacion: #{$color_informacion};
$color-disabled: #{$color_disabled};
$ancho-maximo: 200rem; //62.5rem es la medida estandar de foundation.

$small-screen: 641px !default;
$medium-screen: 1280px !default;
$large-screen: 1440px !default;

$input-color: #{$primary_font_color};
$label-color: #{$secondary_font_color};